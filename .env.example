# Optional: dedicated BSC RPC endpoint (recommended over the public default,
# which is rate-limited and not guaranteed to stay available).
# Free options: https://www.ankr.com/rpc/bsc/, https://nodereal.io, getblock.io
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Required for /api/transactions/:address
# Get a free key at https://bscscan.com/myapikey
BSCSCAN_API_KEY=

# Optional: if you add your own auth middleware (recommended before going
# public), put a shared secret here and check it in api/send.js.
# API_AUTH_TOKEN=
